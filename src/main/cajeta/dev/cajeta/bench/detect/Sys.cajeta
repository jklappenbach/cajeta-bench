package dev.cajeta.bench.detect;

import cajeta.io.file.File;
import cajeta.io.file.FileReader;
import cajeta.process.Command;
import cajeta.process.ProcessResult;

/**
 * The little I/O the detectors need, each call answering "" rather than
 * failing: a small file's text, a program's stdout, and two text scanners
 * (`KEY=VALUE` lines and the token after a label).
 *
 * Measured on cajeta 0.46.3: `File.openRead` of a missing path returns a
 * reader with `fd == -1`, not null, and `File.readAllBytes` of one returns
 * null; a `Command` whose program is not on PATH comes back with
 * `launched() == false`. Those are the three cases guarded here.
 */
public final class Sys {

    /** The text of a small file, or "" when it cannot be opened. */
    public static #String readText(String path) {
        FileReader r #= File.openRead(path);
        if (r.fd < 0) {
            return "";
        }
        String text #= r.readString(65536);
        r.close();
        if (text == null) {
            return "";
        }
        return text;
    }

    public static #String run1(String prog, String a1) {
        String[] argv = heap String[2];
        argv[0] = "" + prog;
        argv[1] = "" + a1;
        return Sys.run(#argv);
    }

    public static #String run0(String prog) {
        String[] argv = heap String[1];
        argv[0] = "" + prog;
        return Sys.run(#argv);
    }

    public static #String run2(String prog, String a1, String a2) {
        String[] argv = heap String[3];
        argv[0] = "" + prog;
        argv[1] = "" + a1;
        argv[2] = "" + a2;
        return Sys.run(#argv);
    }

    /**
     * stdout of `argv`, or "" when the program is absent, exits non-zero, or
     * runs past ten seconds. stderr is captured so a missing driver's
     * complaint does not reach the benchmark's terminal.
     */
    public static #String run(#String[] argv) {
        Command c = heap Command(#argv);
        c.captureStdout();
        c.captureStderr();
        c.timeoutMillis((int64) 10000);
        ProcessResult r #= c.run();
        if (!r.launched()) {
            return "";
        }
        if (r.timedOut()) {
            return "";
        }
        if (r.exitCode() != 0) {
            return "";
        }
        // stdout() is a borrow of the result's interior: copy it out.
        return Sys.copyText(r.stdout());
    }

    /** An owned String copy of `bytes` (a ProcessResult's stdout/stderr borrow); "" for null. */
    public static #String copyText(int8[] bytes) {
        if (bytes == null) {
            return "";
        }
        int32 n = (int32) bytes.count();
        int8[] cp = heap int8[n];
        int32 i = 0;
        while (i < n) {
            cp[i] = bytes[i];
            i = i + 1;
        }
        return heap String(#cp, n);
    }

    /**
     * The value of the `key=value` line for `key` (os-release shape), with
     * surrounding whitespace and one pair of double quotes removed.
     */
    public static #String keyValue(String text, String key) {
        if (text == null) {
            return "";
        }
        String needle #= key + "=";
        int64 at = (int64) -1;
        if (text.startsWith(needle)) {
            at = (int64) 0;
        } else {
            String nlNeedle #= "\n" + needle;
            int64 idx = text.indexOf(nlNeedle);
            if (idx >= 0) {
                at = idx + 1;
            }
        }
        if (at < 0) {
            return "";
        }
        int32 n = text.byteLength();
        int32 start = (int32) at + needle.byteLength();
        int32 end = Sys.lineEnd(text, start);
        String raw #= text.substring(start, end);
        String v #= raw.trim();
        int32 vn = v.byteLength();
        if (vn >= 2 && v.byteAt(0) == 34 && v.byteAt(vn - 1) == 34) {
            return v.substring(1, vn - 1);
        }
        return v;
    }

    /** The whitespace-delimited token after `label`, or "". */
    public static #String tokenAfter(String text, String label) {
        if (text == null) {
            return "";
        }
        int64 at = text.indexOf(label);
        if (at < 0) {
            return "";
        }
        int32 n = text.byteLength();
        int32 i = (int32) at + label.byteLength();
        while (i < n && Sys.isSpace(text.byteAt(i))) {
            i = i + 1;
        }
        int32 j = i;
        while (j < n && !Sys.isSpace(text.byteAt(j))) {
            j = j + 1;
        }
        return text.substring(i, j);
    }

    /** The first line of `text`, trimmed. */
    public static #String firstLine(String text) {
        if (text == null) {
            return "";
        }
        int32 end = Sys.lineEnd(text, 0);
        String raw #= text.substring(0, end);
        return raw.trim();
    }

    /** Index of the '\n' (or '\r') ending the line that starts at `from`. */
    public static int32 lineEnd(String text, int32 from) {
        int32 n = text.byteLength();
        int32 i = from;
        while (i < n) {
            int8 c = text.byteAt(i);
            if (c == 10 || c == 13) {
                return i;
            }
            i = i + 1;
        }
        return n;
    }

    public static boolean isSpace(int8 c) {
        return c == 32 || c == 9 || c == 10 || c == 13;
    }
}
