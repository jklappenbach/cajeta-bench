package dev.cajeta.bench;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;
import dev.cajeta.bench.BenchConfig;
import dev.cajeta.bench.report.Result;
import dev.cajeta.bench.report.Memory;
import dev.cajeta.bench.Trials;
import dev.cajeta.bench.detect.DriverDetect;

// The measurement loop (profile spec §4, benchmark-reference spec §3). Runs a
// benchmark through idiomatic warmup then N measured trials, timing each with
// the run's clock (BenchConfig.clock, the monotonic Clock.nanoTime unless a
// test substitutes one) and subtracting the benchmark's declared
// per-iteration baseline. Captures peak RSS (VmHWM) and the working-set delta
// (peak − pre-workload VmRSS), computes the min/median/mean/p95 distribution,
// runs the correctness cross-check, and returns a filled schema-v2 Result.
//
// Three behaviors beyond the profile harness:
//   * a throw from setup or from a variant's measurement is a `failed` row
//     carrying the message, and the run continues (spec §3.3.2);
//   * smoke mode (BenchConfig.smoke) collapses warmup to 1 and trials to 3
//     and tags every row `smoke` (spec §3.3.3);
//   * a row whose backend() is not "cpu" and that declares a competitor is
//     measured in interleaved rounds, ours then competitor, and each side's
//     median goes on its own row (spec §8.1, plan 14.1.3).
public class Harness {

    // Measure every benchmark in `list`, in order, appending to `rows`.
    public static void measureAll(ArrayList<Benchmark> list, BenchConfig cfg, ArrayList<Result> rows) {
        int32 i = 0;
        int32 n = list.count();
        while (i < n) {
            Benchmark b = list.get(i);
            Harness.measureInto(b, cfg, rows);
            i = i + 1;
        }
    }

    // Measure one benchmark across all its variants, appending one Result row
    // per variant (two for an interleaved variant). setup() runs once;
    // prepare(variant) builds each variant's input; teardown() runs once at
    // the end.
    public static void measureInto(Benchmark b, BenchConfig cfg, ArrayList<Result> rows) {
        // --variant / --backend: a benchmark with no variant passing both
        // contributes nothing, and is not set up.
        if (!cfg.variantFilter.isEmpty() || !cfg.backendFilter.isEmpty()) {
            if (!Harness.picksAny(b, cfg.variantFilter, cfg.backendFilter)) {
                return;
            }
        }
        boolean setupOk = true;
        String setupMsg = "";
        try {
            b.setup();
        } catch (Throwable e) {
            setupOk = false;
            setupMsg #= Harness.messageOf(e);
        }
        Harness.collectEnv(b, cfg);
        if (!setupOk) {
            // A benchmark that says it cannot run here is skipped, not failed,
            // even when its setup threw for that reason.
            if (!b.available()) {
                String why = b.unavailableReason();
                rows.add(Harness.skippedRow(b, cfg, "", why));
            } else {
                rows.add(Harness.failedRow(b, cfg, "", "setup threw: " + setupMsg));
            }
            return;
        }
        ArrayList<String> vs #= b.variants();
        int32 vi = 0;
        int32 vn = vs.count();
        while (vi < vn) {
            String v = vs.get(vi);
            if (!Harness.picks(b, v, cfg.variantFilter, cfg.backendFilter)) {
                // not selected
            } else if (b.supportsVariant(v)) {
                try {
                    // prepare first: available() and the interleave decision
                    // may read what prepare(variant) set.
                    b.prepare(v);
                    if (!b.available()) {
                        String why = b.unavailableReason();
                        rows.add(Harness.skippedRow(b, cfg, v, why));
                    } else if (Harness.interleaves(b, v)) {
                        Harness.measureInterleavedPrepared(b, cfg, v, rows);
                    } else {
                        // Owned temporary straight into the list.
                        rows.add(Harness.measurePrepared(b, cfg, v));
                    }
                } catch (Throwable e) {
                    String msg #= Harness.messageOf(e);
                    rows.add(Harness.failedRow(b, cfg, v, msg));
                }
                try {
                    b.finishVariant(v);
                } catch (Throwable e) {
                    String fmsg #= Harness.messageOf(e);
                    System.stdout.println("bench: " + b.name() + " finishVariant(" + v + ") threw: " + fmsg);
                }
                Harness.collectEnv(b, cfg);
            } else {
                String why = b.skipReasonFor(v);
                rows.add(Harness.skippedRow(b, cfg, v, why));
            }
            vi = vi + 1;
        }
        try {
            b.teardown();
        } catch (Throwable e) {
            String msg #= Harness.messageOf(e);
            System.stdout.println("bench: " + b.name() + " teardown threw: " + msg);
        }
        Harness.collectEnv(b, cfg);
    }

    // Move b's envExtra lines into the run's env.csv extras.
    public static void collectEnv(Benchmark b, BenchConfig cfg) {
        if (b.envKeys == null) {
            return;
        }
        int32 i = 0;
        while (i < b.envKeys.count()) {
            String k = b.envKeys.get(i);
            String v = b.envValues.get(i);
            cfg.addEnv(k, v);
            i = i + 1;
        }
        b.envKeys = null;
        b.envValues = null;
    }

    // "a; b" of the non-empty parts.
    public static #String join(String a, String b) {
        if (a.isEmpty()) {
            return "" + b;
        }
        if (b.isEmpty()) {
            return "" + a;
        }
        return a + "; " + b;
    }

    // baseline>=measured: the row is invalid unless the benchmark allows it.
    public static void applyBaseline(Benchmark b, Result r, Trials tr) {
        if (tr.baselineHits > 0 && !b.allowZeroAfterBaseline()) {
            r.checkOk = false;
            r.status = "invalid";
        }
    }

    // True when `b`'s `variant` is measured in interleaved rounds against its competitor.
    public static boolean interleaves(Benchmark b, String variant) {
        if (!b.hasCompetitor()) {
            return false;
        }
        String be = b.backendFor(variant);
        return !be.equals("cpu");
    }

    // Whether variant `v` passes --variant (its label) and --backend (where
    // it runs, backendFor(v)). A null or empty filter admits everything.
    public static boolean picks(Benchmark b, String v, String variantFilter, String backendFilter) {
        if (variantFilter != null && !variantFilter.isEmpty() && !v.equals(variantFilter)) {
            return false;
        }
        if (backendFilter != null && !backendFilter.isEmpty()) {
            String be = b.backendFor(v);
            if (!be.equals(backendFilter)) {
                return false;
            }
        }
        return true;
    }

    // Whether any variant of `b` passes both filters.
    public static boolean picksAny(Benchmark b, String variantFilter, String backendFilter) {
        ArrayList<String> vs #= b.variants();
        int32 i = 0;
        int32 n = vs.count();
        while (i < n) {
            if (Harness.picks(b, vs.get(i), variantFilter, backendFilter)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public static boolean hasVariant(Benchmark b, String label) {
        ArrayList<String> vs #= b.variants();
        int32 i = 0;
        int32 n = vs.count();
        while (i < n) {
            String v = vs.get(i);
            if (v.equals(label)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // throughput = inputSize / median seconds, three decimals, when the
    // benchmark declares an input size and the median is positive.
    public static void fillThroughput(Result r) {
        if (r.inputSize < 0 || r.medianNs <= 0) {
            return;
        }
        float64 perSec = ((float64) r.inputSize) * 1000000000.0 / ((float64) r.medianNs);
        r.throughput #= Harness.fixed3(perSec);
    }

    // The row's throughput from what the trials reported, when any did:
    // their median, labelled with the reported unit.
    public static void fillReportedThroughput(Result r, float64[] tps, int32 n, String unit) {
        if (n <= 0) {
            return;
        }
        Harness.sortF64(tps, n);
        r.throughput #= Harness.fixed3(tps[n / 2]);
        r.throughputUnit = "" + unit;
    }

    // `reported` when every trial reported its own time, `reported (k of n
    // trials)` when some did, "" when none did.
    public static #String reportedTag(int32 reported, int32 trials) {
        if (reported <= 0) {
            return "";
        }
        if (reported >= trials) {
            return "reported";
        }
        return "reported (" + reported + " of " + trials + " trials)";
    }

    public static void sortF64(float64[] a, int32 n) {
        int32 i = 1;
        while (i < n) {
            float64 key = a[i];
            int32 j = i - 1;
            while (j >= 0 && a[j] > key) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = key;
            i = i + 1;
        }
    }

    // `v` with exactly three decimals, rounded half up ("" for a negative or
    // out-of-range value).
    public static #String fixed3(float64 v) {
        if (v < 0.0 || v > 9000000000000000.0) {
            return "";
        }
        int64 scaled = (int64) (v * 1000.0 + 0.5);
        int64 whole = scaled / 1000;
        int64 frac = scaled % 1000;
        String f = "" + frac;
        if (frac < 10) {
            f = "00" + frac;
        } else if (frac < 100) {
            f = "0" + frac;
        }
        return "" + whole + "." + f;
    }

    public static int32 warmupFor(Benchmark b, BenchConfig cfg) {
        if (cfg.smoke) {
            return 1;
        }
        return b.warmupIters();
    }

    public static int32 trialsFor(Benchmark b, BenchConfig cfg) {
        if (cfg.smoke) {
            return 3;
        }
        int32 t = b.measuredIters();
        if (t < 1) {
            t = 1;
        }
        return t;
    }

    // prepare(variant), then measurePrepared.
    public static #Result measureOne(Benchmark b, BenchConfig cfg, String variant) {
        b.prepare(variant);
        return Harness.measurePrepared(b, cfg, variant);
    }

    public static #Result measurePrepared(Benchmark b, BenchConfig cfg, String variant) {
        int32 warm = Harness.warmupFor(b, cfg);
        int32 trials = Harness.trialsFor(b, cfg);
        int64 baseline = b.baselineNanos();

        // Warmup — reach steady state before measuring.
        b.warmupNow = true;
        int32 w = 0;
        while (w < warm) {
            b.clearReported();
            b.runVariant(variant, 1);
            w = w + 1;
        }
        b.warmupNow = false;

        // Pre-workload resident baseline (overhead-subtraction reference).
        int64 baseRss = Memory.currentRssKb();

        // Measured trials.
        Trials tr = heap Trials(trials);
        int32 t = 0;
        while (t < trials) {
            b.clearReported();
            int64 t0 = cfg.clock.nanoTime();
            b.runVariant(variant, 1);
            int64 t1 = cfg.clock.nanoTime();
            tr.addTrial(b, t1 - t0, baseline);
            t = t + 1;
        }

        int64 peak = Memory.peakRssKb();
        boolean ok = b.checkResult();

        Result r #= Harness.baseRow(b, cfg, variant, true);
        r.inputSize = b.inputSize();
        r.warmup = warm;
        r.trials = trials;
        String tags #= tr.fill(r);
        Harness.fillMemory(b, variant, r, peak, baseRss);
        Harness.markChecked(r, ok);
        Harness.applyBaseline(b, r, tr);
        String lead #= Harness.leadFor(b, tags);
        r.notes #= Harness.notesFor(b, cfg, variant, lead);
        return r;
    }

    // Interleaved rounds for a device row with a competitor: warmup rounds of
    // (ours, competitor), then `trials` timed rounds of (ours, competitor),
    // then one untimed run of ours for the allocation count. Appends our row,
    // then the competitor's.
    public static void measureInterleavedInto(Benchmark b, BenchConfig cfg, String variant,
                                              ArrayList<Result> rows) {
        b.prepare(variant);
        Harness.measureInterleavedPrepared(b, cfg, variant, rows);
    }

    public static void measureInterleavedPrepared(Benchmark b, BenchConfig cfg, String variant,
                                                  ArrayList<Result> rows) {
        int32 warm = Harness.warmupFor(b, cfg);
        int32 trials = Harness.trialsFor(b, cfg);
        int64 baseline = b.baselineNanos();

        b.warmupNow = true;
        int32 w = 0;
        while (w < warm) {
            b.clearReported();
            b.runVariant(variant, 1);
            b.runCompetitor(variant, 1);
            w = w + 1;
        }
        b.warmupNow = false;

        int64 baseRss = Memory.currentRssKb();

        Trials tr = heap Trials(trials);
        int64[] comp = heap int64[trials];
        int32 t = 0;
        while (t < trials) {
            b.clearReported();
            int64 t0 = cfg.clock.nanoTime();
            b.runVariant(variant, 1);
            int64 t1 = cfg.clock.nanoTime();
            tr.addTrial(b, t1 - t0, baseline);

            int64 t2 = cfg.clock.nanoTime();
            b.runCompetitor(variant, 1);
            int64 t3 = cfg.clock.nanoTime();
            int64 dc = t3 - t2;
            if (dc < 0) {
                dc = 0;
            }
            comp[t] = dc;
            t = t + 1;
        }

        int64 peak = Memory.peakRssKb();
        boolean okOurs = b.checkResult();
        boolean okComp = b.checkCompetitor();

        Result r #= Harness.baseRow(b, cfg, variant, true);
        r.inputSize = b.inputSize();
        r.warmup = warm;
        r.trials = trials;
        String tags #= tr.fill(r);
        Harness.fillMemory(b, variant, r, peak, baseRss);
        Harness.markChecked(r, okOurs);
        Harness.applyBaseline(b, r, tr);
        String lead0 #= Harness.join("interleaved", tags);
        String lead #= Harness.leadFor(b, lead0);
        r.notes #= Harness.notesFor(b, cfg, variant, lead);
        rows.add(#r);

        String cl = b.competitorLanguage();
        String cp = b.competitorPlatform();
        String cv = b.competitorVersion();
        Result c #= Harness.baseRow(b, cfg, variant, true);
        c.language = "" + cl;
        c.platform = "" + cp;
        c.languageVersion = "" + cv;
        // The competitor's build flags belong in competitorNote(); this row's
        // flags column is not ours to claim.
        c.flags = "";
        c.inputSize = b.inputSize();
        c.warmup = warm;
        c.trials = trials;
        Harness.fillStats(c, comp, trials);
        Harness.fillThroughput(c);
        Harness.markChecked(c, okComp);
        c.notes #= Harness.notesFor(b, cfg, variant, "interleaved");
        rows.add(#c);
    }

    // Allocation intensity: bytes one representative execution requests from
    // the heap allocator (Cajeta.allocatedBytes() is a cumulative runtime
    // counter; the delta around a single run is the per-execution figure that
    // matches the competitors' counting-allocator / tracemalloc numbers).
    // Measured OUTSIDE the timed region so it cannot perturb min_ns.
    public static int64 allocOfOneRun(Benchmark b, String variant) {
        int64 allocBase = Cajeta.allocatedBytes();
        b.runVariant(variant, 1);
        int64 allocBytes = Cajeta.allocatedBytes() - allocBase;
        if (allocBytes < 0) {
            allocBytes = 0;
        }
        return allocBytes;
    }

    // The memory columns. In-process work: peak RSS of this process, the
    // working-set delta, and the allocator count of one untimed run. External
    // work: the child's peak (Benchmark.measuredPeakRssKb, one more untimed
    // run), and -1 for the two columns this process cannot see into.
    public static void fillMemory(Benchmark b, String variant, Result r, int64 peak, int64 baseRss) {
        if (b.external()) {
            r.peakRssKb = b.measuredPeakRssKb();
            r.workingSetKb = (int64) -1;
            r.allocBytes = (int64) -1;
            return;
        }
        r.peakRssKb = peak;
        r.workingSetKb = Harness.workingSet(peak, baseRss);
        r.allocBytes = Harness.allocOfOneRun(b, variant);
    }

    // The notes lead for a measured row: `lead`, prefixed `external` for a child process.
    public static #String leadFor(Benchmark b, String lead) {
        if (!b.external()) {
            return "" + lead;
        }
        if (lead.isEmpty()) {
            return "external";
        }
        return "external; " + lead;
    }

    public static int64 workingSet(int64 peak, int64 baseRss) {
        int64 ws = peak - baseRss;
        if (ws < 0) {
            ws = 0;
        }
        return ws;
    }

    public static void markChecked(Result r, boolean ok) {
        r.checkOk = ok;
        if (ok) {
            r.status = "ok";
        } else {
            r.status = "invalid";
        }
    }

    // min / median / mean / p95 of samples[0..n) (sorted in place).
    public static void fillStats(Result r, int64[] samples, int32 n) {
        if (n <= 0) {
            return;
        }
        Harness.sortInPlace(samples, n);
        int64 sum = 0;
        int32 i = 0;
        while (i < n) {
            sum = sum + samples[i];
            i = i + 1;
        }
        r.minNs = samples[0];
        r.medianNs = samples[n / 2];
        r.meanNs = sum / (int64) n;
        r.p95Ns = samples[Harness.p95Index(n)];
    }

    // The identity columns every row of `b` carries, whatever its status.
    // `probe`: a measured row may run the driver probe (once per family); a
    // skipped or failed row only takes what is already known.
    public static #Result baseRow(Benchmark b, BenchConfig cfg, String variant, boolean probe) {
        // Materialize names into locals first (reading a class-param's method
        // result inline into a field has bitten us before — bind, then store).
        String nm = b.name();
        String ar = b.area();
        String be = b.backendFor(variant);
        String ds = b.datasetInfo();
        String mach = b.machine();
        String un = b.unit();
        String mo = b.model();
        String drv = "";
        if (probe) {
            drv #= cfg.driverFor(be);
        } else {
            drv #= cfg.knownDriver(be);
        }
        String lang = b.languageFor(variant);
        String lv = b.languageVersionFor(variant);
        String pl = b.platformFor(variant);
        String fl = b.flagsFor(variant);
        String label = b.variantLabel(variant);
        String lib = b.libraryFor(variant);
        String libv = b.libraryVersionFor(variant);

        Result r = heap Result();
        // Owned copies of borrowed values — storing a borrow into a field
        // that outlives the call dangles after return.
        r.runId = "" + cfg.runId;
        r.timestampUnix = "" + cfg.clock.unixSeconds();
        r.library = "" + lib;
        r.libraryVersion = "" + libv;
        r.benchmark = "" + nm;
        r.area = "" + ar;
        r.variant = "" + label;
        r.datasetName = "" + ds;
        if (lang.isEmpty()) {
            r.language = "cajeta";
        } else {
            r.language = "" + lang;
        }
        boolean cajetaRow = r.language.equals("cajeta");
        if (lv.isEmpty() && cajetaRow) {
            r.languageVersion = "" + cfg.languageVersion;
        } else {
            r.languageVersion = "" + lv;
        }
        r.backend = "" + be;
        if (fl.isEmpty() && cajetaRow) {
            r.flags = "" + cfg.flags;
        } else {
            r.flags = "" + fl;
        }
        r.throughputUnit = "" + un;
        r.machine = "" + mach;
        r.os = "" + cfg.os;
        r.driver = "" + drv;
        r.model = "" + mo;
        if (pl.isEmpty()) {
            r.platform = "" + r.language;
        } else {
            r.platform = "" + pl;
        }
        return r;
    }

    // notes = lead; noteFor(variant); `smoke` — the non-empty parts, "; "-joined.
    public static #String notesFor(Benchmark b, BenchConfig cfg, String variant, String lead) {
        String note = b.noteFor(variant);
        String s = "" + lead;
        if (!note.isEmpty()) {
            if (s.isEmpty()) {
                s = "" + note;
            } else {
                s = s + "; " + note;
            }
        }
        if (cfg.noGpu) {
            String be = b.backendFor(variant);
            String fam #= DriverDetect.family(be);
            if (!fam.isEmpty()) {
                s #= Harness.join(s, "driver: not probed");
            }
        }
        if (cfg.smoke) {
            if (s.isEmpty()) {
                s = "smoke";
            } else {
                s = s + "; smoke";
            }
        }
        return s;
    }

    // A recorded skip row (never a silent omission) for a benchmark or
    // variant that can't run here.
    public static #Result skippedRow(Benchmark b, BenchConfig cfg, String variant, String reason) {
        Result r #= Harness.baseRow(b, cfg, variant, false);
        r.status = "skipped";
        r.checkOk = false;
        // Nothing was measured, so there is no throughput to give a unit to.
        r.throughputUnit = "";
        r.notes #= Harness.notesFor(b, cfg, variant, reason);
        return r;
    }

    // A recorded failure: the benchmark threw. `message` lands in notes.
    public static #Result failedRow(Benchmark b, BenchConfig cfg, String variant, String message) {
        Result r #= Harness.baseRow(b, cfg, variant, false);
        r.status = "failed";
        r.checkOk = false;
        r.notes #= Harness.notesFor(b, cfg, variant, message);
        return r;
    }

    public static #String messageOf(Throwable e) {
        String m = e.getMessage();
        if (m == null) {
            return "exception with no message";
        }
        if (m.isEmpty()) {
            return "exception with no message";
        }
        return "" + m;
    }

    public static int32 p95Index(int32 n) {
        int32 idx = (n * 95) / 100;
        if (idx >= n) {
            idx = n - 1;
        }
        return idx;
    }

    // Insertion sort over the first n entries — simple and ample for n in the
    // low hundreds (the measured-trial counts).
    public static void sortInPlace(int64[] a, int32 n) {
        int32 i = 1;
        while (i < n) {
            int64 key = a[i];
            int32 j = i - 1;
            while (j >= 0 && a[j] > key) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = key;
            i = i + 1;
        }
    }
}
