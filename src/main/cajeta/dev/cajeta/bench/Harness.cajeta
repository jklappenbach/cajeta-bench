package dev.cajeta.bench;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Benchmark;
import dev.cajeta.bench.BenchConfig;
import dev.cajeta.bench.report.Result;
import dev.cajeta.bench.report.Memory;

// The measurement loop (profile spec §4, benchmark-reference spec §3). Runs a
// benchmark through idiomatic warmup then N measured trials, timing each with
// the run's clock (BenchConfig.clock, the monotonic Clock.nanoTime unless a
// test substitutes one) and subtracting the benchmark's declared
// per-iteration baseline. Captures peak RSS (VmHWM) and the working-set delta
// (peak − pre-workload VmRSS), computes the min/median/mean/p95 distribution,
// runs the correctness cross-check, and returns a filled schema-v2 Result.
//
// Three behaviors beyond the profile harness:
//   * a throw from setup or from a variant's measurement is a `failed` row
//     carrying the message, and the run continues (spec §3.3.2);
//   * smoke mode (BenchConfig.smoke) collapses warmup to 1 and trials to 3
//     and tags every row `smoke` (spec §3.3.3);
//   * a row whose backend() is not "cpu" and that declares a competitor is
//     measured in interleaved rounds, ours then competitor, and each side's
//     median goes on its own row (spec §8.1, plan 14.1.3).
public class Harness {

    // Measure every benchmark in `list`, in order, appending to `rows`.
    public static void measureAll(ArrayList<Benchmark> list, BenchConfig cfg, ArrayList<Result> rows) {
        int32 i = 0;
        int32 n = list.count();
        while (i < n) {
            Benchmark b = list.get(i);
            Harness.measureInto(b, cfg, rows);
            i = i + 1;
        }
    }

    // Measure one benchmark across all its variants, appending one Result row
    // per variant (two for an interleaved variant). setup() runs once;
    // prepare(variant) builds each variant's input; teardown() runs once at
    // the end.
    public static void measureInto(Benchmark b, BenchConfig cfg, ArrayList<Result> rows) {
        if (!b.available()) {
            rows.add(Harness.skippedRow(b, cfg, "",
                "unavailable (dataset not configured or not fetched)"));
            return;
        }
        boolean setupOk = true;
        try {
            b.setup();
        } catch (Throwable e) {
            setupOk = false;
            String msg #= Harness.messageOf(e);
            rows.add(Harness.failedRow(b, cfg, "", "setup threw: " + msg));
        }
        if (!setupOk) {
            return;
        }
        ArrayList<String> vs #= b.variants();
        int32 vi = 0;
        int32 vn = vs.count();
        while (vi < vn) {
            String v = vs.get(vi);
            if (b.supportsVariant(v)) {
                try {
                    if (Harness.interleaves(b)) {
                        Harness.measureInterleavedInto(b, cfg, v, rows);
                    } else {
                        // Owned temporary straight into the list.
                        rows.add(Harness.measureOne(b, cfg, v));
                    }
                } catch (Throwable e) {
                    String msg #= Harness.messageOf(e);
                    rows.add(Harness.failedRow(b, cfg, v, msg));
                }
            } else {
                String why = b.skipReason();
                rows.add(Harness.skippedRow(b, cfg, v, why));
            }
            vi = vi + 1;
        }
        try {
            b.teardown();
        } catch (Throwable e) {
            String msg #= Harness.messageOf(e);
            System.stdout.println("bench: " + b.name() + " teardown threw: " + msg);
        }
    }

    // True when `b` is measured in interleaved rounds against its competitor.
    public static boolean interleaves(Benchmark b) {
        if (!b.hasCompetitor()) {
            return false;
        }
        String be = b.backend();
        return !be.equals("cpu");
    }

    public static int32 warmupFor(Benchmark b, BenchConfig cfg) {
        if (cfg.smoke) {
            return 1;
        }
        return b.warmupIters();
    }

    public static int32 trialsFor(Benchmark b, BenchConfig cfg) {
        if (cfg.smoke) {
            return 3;
        }
        int32 t = b.measuredIters();
        if (t < 1) {
            t = 1;
        }
        return t;
    }

    public static #Result measureOne(Benchmark b, BenchConfig cfg, String variant) {
        b.prepare(variant);

        int32 warm = Harness.warmupFor(b, cfg);
        int32 trials = Harness.trialsFor(b, cfg);
        int64 baseline = b.baselineNanos();

        // Warmup — reach steady state before measuring.
        int32 w = 0;
        while (w < warm) {
            b.runVariant(variant, 1);
            w = w + 1;
        }

        // Pre-workload resident baseline (overhead-subtraction reference).
        int64 baseRss = Memory.currentRssKb();

        // Measured trials.
        int64[] samples = heap int64[trials];
        int32 t = 0;
        while (t < trials) {
            int64 t0 = cfg.clock.nanoTime();
            b.runVariant(variant, 1);
            int64 t1 = cfg.clock.nanoTime();
            int64 dur = t1 - t0 - baseline;
            if (dur < 0) {
                dur = 0;
            }
            samples[t] = dur;
            t = t + 1;
        }

        int64 peak = Memory.peakRssKb();
        boolean ok = b.checkResult();

        Result r #= Harness.baseRow(b, cfg, variant);
        r.inputSize = b.inputSize();
        r.warmup = warm;
        r.trials = trials;
        Harness.fillStats(r, samples, trials);
        Harness.fillMemory(b, variant, r, peak, baseRss);
        Harness.markChecked(r, ok);
        r.notes #= Harness.notesFor(b, cfg, Harness.leadFor(b, ""));
        return r;
    }

    // Interleaved rounds for a device row with a competitor: warmup rounds of
    // (ours, competitor), then `trials` timed rounds of (ours, competitor),
    // then one untimed run of ours for the allocation count. Appends our row,
    // then the competitor's.
    public static void measureInterleavedInto(Benchmark b, BenchConfig cfg, String variant,
                                              ArrayList<Result> rows) {
        b.prepare(variant);

        int32 warm = Harness.warmupFor(b, cfg);
        int32 trials = Harness.trialsFor(b, cfg);
        int64 baseline = b.baselineNanos();

        int32 w = 0;
        while (w < warm) {
            b.runVariant(variant, 1);
            b.runCompetitor(variant, 1);
            w = w + 1;
        }

        int64 baseRss = Memory.currentRssKb();

        int64[] ours = heap int64[trials];
        int64[] comp = heap int64[trials];
        int32 t = 0;
        while (t < trials) {
            int64 t0 = cfg.clock.nanoTime();
            b.runVariant(variant, 1);
            int64 t1 = cfg.clock.nanoTime();
            int64 d = t1 - t0 - baseline;
            if (d < 0) {
                d = 0;
            }
            ours[t] = d;

            int64 t2 = cfg.clock.nanoTime();
            b.runCompetitor(variant, 1);
            int64 t3 = cfg.clock.nanoTime();
            int64 dc = t3 - t2;
            if (dc < 0) {
                dc = 0;
            }
            comp[t] = dc;
            t = t + 1;
        }

        int64 peak = Memory.peakRssKb();
        boolean okOurs = b.checkResult();
        boolean okComp = b.checkCompetitor();

        Result r #= Harness.baseRow(b, cfg, variant);
        r.inputSize = b.inputSize();
        r.warmup = warm;
        r.trials = trials;
        Harness.fillStats(r, ours, trials);
        Harness.fillMemory(b, variant, r, peak, baseRss);
        Harness.markChecked(r, okOurs);
        r.notes #= Harness.notesFor(b, cfg, Harness.leadFor(b, "interleaved"));
        rows.add(#r);

        String cl = b.competitorLanguage();
        String cp = b.competitorPlatform();
        String cv = b.competitorVersion();
        Result c #= Harness.baseRow(b, cfg, variant);
        c.language = "" + cl;
        c.platform = "" + cp;
        c.languageVersion = "" + cv;
        // The competitor's build flags belong in competitorNote(); this row's
        // flags column is not ours to claim.
        c.flags = "";
        c.inputSize = b.inputSize();
        c.warmup = warm;
        c.trials = trials;
        Harness.fillStats(c, comp, trials);
        Harness.markChecked(c, okComp);
        c.notes #= Harness.notesFor(b, cfg, "interleaved");
        rows.add(#c);
    }

    // Allocation intensity: bytes one representative execution requests from
    // the heap allocator (Cajeta.allocatedBytes() is a cumulative runtime
    // counter; the delta around a single run is the per-execution figure that
    // matches the competitors' counting-allocator / tracemalloc numbers).
    // Measured OUTSIDE the timed region so it cannot perturb min_ns.
    public static int64 allocOfOneRun(Benchmark b, String variant) {
        int64 allocBase = Cajeta.allocatedBytes();
        b.runVariant(variant, 1);
        int64 allocBytes = Cajeta.allocatedBytes() - allocBase;
        if (allocBytes < 0) {
            allocBytes = 0;
        }
        return allocBytes;
    }

    // The memory columns. In-process work: peak RSS of this process, the
    // working-set delta, and the allocator count of one untimed run. External
    // work: the child's peak (Benchmark.measuredPeakRssKb, one more untimed
    // run), and -1 for the two columns this process cannot see into.
    public static void fillMemory(Benchmark b, String variant, Result r, int64 peak, int64 baseRss) {
        if (b.external()) {
            r.peakRssKb = b.measuredPeakRssKb();
            r.workingSetKb = (int64) -1;
            r.allocBytes = (int64) -1;
            return;
        }
        r.peakRssKb = peak;
        r.workingSetKb = Harness.workingSet(peak, baseRss);
        r.allocBytes = Harness.allocOfOneRun(b, variant);
    }

    // The notes lead for a measured row: `lead`, prefixed `external` for a child process.
    public static #String leadFor(Benchmark b, String lead) {
        if (!b.external()) {
            return "" + lead;
        }
        if (lead.isEmpty()) {
            return "external";
        }
        return "external; " + lead;
    }

    public static int64 workingSet(int64 peak, int64 baseRss) {
        int64 ws = peak - baseRss;
        if (ws < 0) {
            ws = 0;
        }
        return ws;
    }

    public static void markChecked(Result r, boolean ok) {
        r.checkOk = ok;
        if (ok) {
            r.status = "ok";
        } else {
            r.status = "invalid";
        }
    }

    // min / median / mean / p95 of samples[0..n) (sorted in place).
    public static void fillStats(Result r, int64[] samples, int32 n) {
        if (n <= 0) {
            return;
        }
        Harness.sortInPlace(samples, n);
        int64 sum = 0;
        int32 i = 0;
        while (i < n) {
            sum = sum + samples[i];
            i = i + 1;
        }
        r.minNs = samples[0];
        r.medianNs = samples[n / 2];
        r.meanNs = sum / (int64) n;
        r.p95Ns = samples[Harness.p95Index(n)];
    }

    // The identity columns every row of `b` carries, whatever its status.
    public static #Result baseRow(Benchmark b, BenchConfig cfg, String variant) {
        // Materialize names into locals first (reading a class-param's method
        // result inline into a field has bitten us before — bind, then store).
        String nm = b.name();
        String ar = b.area();
        String be = b.backend();
        String ds = b.datasetInfo();
        String mach = b.machine();
        String un = b.unit();
        String mo = b.model();
        String pl = b.platform();
        String drv #= cfg.driverFor(be);

        Result r = heap Result();
        // Owned copies of borrowed values — storing a borrow into a field
        // that outlives the call dangles after return.
        r.runId = "" + cfg.runId;
        r.benchmark = "" + nm;
        r.area = "" + ar;
        r.variant = "" + variant;
        r.datasetName = "" + ds;
        r.language = "cajeta";
        r.languageVersion = "" + cfg.languageVersion;
        r.backend = "" + be;
        r.flags = "" + cfg.flags;
        r.throughputUnit = "" + un;
        r.machine = "" + mach;
        r.os = "" + cfg.os;
        r.driver = "" + drv;
        r.model = "" + mo;
        if (pl.isEmpty()) {
            r.platform = "cajeta";
        } else {
            r.platform = "" + pl;
        }
        return r;
    }

    // notes = lead; competitorNote(); `smoke` — the non-empty parts, "; "-joined.
    public static #String notesFor(Benchmark b, BenchConfig cfg, String lead) {
        String note = b.competitorNote();
        String s = "" + lead;
        if (!note.isEmpty()) {
            if (s.isEmpty()) {
                s = "" + note;
            } else {
                s = s + "; " + note;
            }
        }
        if (cfg.smoke) {
            if (s.isEmpty()) {
                s = "smoke";
            } else {
                s = s + "; smoke";
            }
        }
        return s;
    }

    // A recorded skip row (never a silent omission) for a benchmark or
    // variant that can't run here.
    public static #Result skippedRow(Benchmark b, BenchConfig cfg, String variant, String reason) {
        Result r #= Harness.baseRow(b, cfg, variant);
        r.status = "skipped";
        r.checkOk = false;
        r.notes #= Harness.notesFor(b, cfg, reason);
        return r;
    }

    // A recorded failure: the benchmark threw. `message` lands in notes.
    public static #Result failedRow(Benchmark b, BenchConfig cfg, String variant, String message) {
        Result r #= Harness.baseRow(b, cfg, variant);
        r.status = "failed";
        r.checkOk = false;
        r.notes #= Harness.notesFor(b, cfg, message);
        return r;
    }

    public static #String messageOf(Throwable e) {
        String m = e.getMessage();
        if (m == null) {
            return "exception with no message";
        }
        if (m.isEmpty()) {
            return "exception with no message";
        }
        return "" + m;
    }

    public static int32 p95Index(int32 n) {
        int32 idx = (n * 95) / 100;
        if (idx >= n) {
            idx = n - 1;
        }
        return idx;
    }

    // Insertion sort over the first n entries — simple and ample for n in the
    // low hundreds (the measured-trial counts).
    public static void sortInPlace(int64[] a, int32 n) {
        int32 i = 1;
        while (i < n) {
            int64 key = a[i];
            int32 j = i - 1;
            while (j >= 0 && a[j] > key) {
                a[j + 1] = a[j];
                j = j - 1;
            }
            a[j + 1] = key;
            i = i + 1;
        }
    }
}
