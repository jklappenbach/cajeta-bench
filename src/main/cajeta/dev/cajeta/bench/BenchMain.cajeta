package dev.cajeta.bench;

import cajeta.collection.ArrayList;
import cajeta.io.file.Path;
import cajeta.lang.StringBuilder;

import dev.cajeta.bench.Benchmark;
import dev.cajeta.bench.BenchConfig;
import dev.cajeta.bench.Harness;
import dev.cajeta.bench.report.Report;
import dev.cajeta.bench.report.Result;

// The bench command line every repo shares (spec §3.1), ported from the
// samples/profile entry point. A consumer's entry point is three lines:
//
//   public static int32 main(String[] args) {
//       ArrayList<Benchmark> b = heap ArrayList<Benchmark>();
//       b.add(heap MyBench());
//       return BenchMain.run(args, b);
//   }
//
//   --list             print each benchmark as `area/name`, measure nothing
//   --run              measure the selected benchmarks and write the CSVs
//   --area <path>      select by catalog path: `collection/hashmap`, or a
//                      prefix of it (`collection` selects collection/*)
//   --bench <name>     select one benchmark by name()
//   --variant <label>  select one variant label of the selected benchmarks
//   --verbose          with --list: every variant, its backend, skip reasons
//   --out <path>       results CSV (default results.csv); env.csv is written
//                      beside it (`<dir>/results.csv` → `<dir>/env.csv`).
//                      A missing directory is created; one that cannot be
//                      (a regular file in the way) is exit 2 before any
//                      measurement, naming the path.
//   --help             this text
//
// Exit status: 0 when every measured row is ok or skipped; 1 when any row
// failed or was invalid, or the selection matched nothing; 2 on a usage error
// or when --out cannot be written. "wrote" is printed only after it happened.
// The run itself never stops at a failing benchmark.
public final class BenchMain {

    public static int32 run(String[] args, ArrayList<Benchmark> benchmarks) {
        boolean listMode = false;
        boolean runMode = false;
        String outPath = "results.csv";
        String areaFilter = null;
        String benchFilter = null;
        String variantFilter = null;
        boolean verbose = false;
        int32 i = 0;
        int32 argc = (int32) args.count();
        while (i < argc) {
            String a = args[i];
            if (a.equals("--list")) {
                listMode = true;
            } else if (a.equals("--run")) {
                runMode = true;
            } else if (a.equals("--verbose") || a.equals("-v")) {
                verbose = true;
            } else if (a.equals("--help") || a.equals("-h")) {
                BenchMain.usage();
                return 0;
            } else if (a.equals("--out") || a.equals("--area") || a.equals("--bench")
                       || a.equals("--variant")) {
                if (i + 1 >= argc) {
                    System.stdout.println("bench: " + a + " needs a value");
                    BenchMain.usage();
                    return 2;
                }
                String v = args[i + 1];
                if (a.equals("--out")) {
                    outPath = v;
                } else if (a.equals("--area")) {
                    areaFilter = v;
                } else if (a.equals("--variant")) {
                    variantFilter = v;
                } else {
                    benchFilter = v;
                }
                i = i + 1;
            } else {
                System.stdout.println("bench: unknown argument '" + a + "'");
                BenchMain.usage();
                return 2;
            }
            i = i + 1;
        }

        if (listMode) {
            return BenchMain.list(benchmarks, areaFilter, benchFilter, variantFilter, verbose);
        }
        if (runMode) {
            return BenchMain.runMeasured(benchmarks, outPath, areaFilter, benchFilter, variantFilter);
        }
        BenchMain.usage();
        return 2;
    }

    public static void usage() {
        System.stdout.println("usage: <bench> --list [--verbose] | --run [--area <path>] [--bench <name>] [--variant <label>] [--out <results.csv>]");
        System.stdout.println("  env: CAJETA_BENCH_SMOKE=1 (warmup 1, trials 3, rows tagged smoke),");
        System.stdout.println("       CAJETA_BENCH_MACHINE, CAJETA_BENCH_RUN_ID, CAJETA_BENCH_CAJETA_VERSION,");
        System.stdout.println("       CAJETA_BENCH_FLAGS");
    }

    // Selection by --area (exact catalog path or a `/`-bounded prefix) and
    // --bench (exact name). A null filter admits everything.
    public static boolean selected(Benchmark b, String areaFilter, String benchFilter) {
        if (areaFilter != null) {
            String ar = b.area();
            if (!ar.equals(areaFilter)) {
                String prefix #= areaFilter + "/";
                if (!ar.startsWith(prefix)) {
                    return false;
                }
            }
        }
        if (benchFilter != null) {
            String nm = b.name();
            if (!nm.equals(benchFilter)) {
                return false;
            }
        }
        return true;
    }

    public static int32 list(ArrayList<Benchmark> benchmarks, String areaFilter, String benchFilter,
                             String variantFilter, boolean verbose) {
        String text #= BenchMain.listing(benchmarks, areaFilter, benchFilter, variantFilter, verbose);
        int32 n = text.byteLength();
        if (n > 0) {
            // println adds the final newline back.
            System.stdout.println(text.substring(0, n - 1));
        }
        return 0;
    }

    public static int32 runMeasured(ArrayList<Benchmark> benchmarks, String outPath,
                                    String areaFilter, String benchFilter, String variantFilter) {
        String why #= BenchMain.prepareOut(outPath);
        if (!why.isEmpty()) {
            System.stdout.println(why);
            return 2;
        }
        BenchConfig cfg #= BenchConfig.fromEnv();
        if (variantFilter != null) {
            cfg.variantFilter = "" + variantFilter;
        }
        if (cfg.smoke) {
            System.stdout.println("bench: SMOKE run (warmup 1, trials 3); rows are tagged smoke and never published");
        }

        ArrayList<Result> rows = heap ArrayList<Result>();
        int32 picked = 0;
        int32 i = 0;
        int32 n = benchmarks.count();
        while (i < n) {
            Benchmark b = benchmarks.get(i);
            if (BenchMain.selected(b, areaFilter, benchFilter)) {
                Harness.measureInto(b, cfg, rows);
                picked = picked + 1;
            }
            i = i + 1;
        }

        int32 bad = 0;
        int32 k = 0;
        int32 rn = rows.count();
        while (k < rn) {
            Result r = rows.get(k);
            System.stdout.println("  " + r.status + "  " + r.area + "/" + r.benchmark
                + " [" + r.language + "] variant='" + r.variant + "'  min_ns=" + r.minNs
                + "  median_ns=" + r.medianNs + "  p95_ns=" + r.p95Ns);
            if (r.status.equals("failed") || r.status.equals("invalid")) {
                System.stdout.println("      " + r.notes);
                bad = bad + 1;
            }
            k = k + 1;
        }

        if (!Report.writeResults(outPath, rows)) {
            System.stdout.println("bench: could not write " + outPath + "; " + rn + " row(s) not saved");
            return 2;
        }
        String envPath #= Report.envPathFor(outPath);
        if (!Report.writeEnv(envPath, cfg)) {
            System.stdout.println("bench: wrote " + outPath + " (" + rn + " rows) but could not write " + envPath);
            return 2;
        }
        System.stdout.println("bench: wrote " + outPath + " (" + rn + " rows) and " + envPath);

        if (picked == 0 || rn == 0) {
            System.stdout.println("bench: the selection matched no benchmark");
            return 1;
        }
        if (bad > 0) {
            System.stdout.println("bench: " + bad + " row(s) failed or invalid");
            return 1;
        }
        return 0;
    }

    // Make --out writable before anything is measured: create its directory
    // when missing. Returns "" when the path is ready, else the error, naming
    // the path, that run() prints before exiting 2.
    public static #String prepareOut(String outPath) {
        int32 n = outPath.byteLength();
        int32 slash = -1;
        int32 i = 0;
        while (i < n) {
            int8 c = outPath.byteAt(i);
            if (c == 47 || c == 92) {
                slash = i;
            }
            i = i + 1;
        }
        if (slash <= 0) {
            return "";
        }
        String dir #= outPath.substring(0, slash);
        Path p #= Path.of(dir);
        if (p.isDir()) {
            return "";
        }
        if (p.exists()) {
            return "bench: cannot write " + outPath + ": " + dir + " exists and is not a directory";
        }
        try {
            p.mkdirs();
        } catch (Throwable e) {
            return "bench: cannot write " + outPath + ": creating " + dir + " failed";
        }
        Path again #= Path.of(dir);
        if (!again.isDir()) {
            return "bench: cannot write " + outPath + ": creating " + dir + " failed";
        }
        return "";
    }

    // The --list text. Plain: one `area/name  [backend]` line per selected
    // benchmark. Verbose: the benchmark, then one line per variant with the
    // backend it runs on and, for an unsupported one, its skip reason. With a
    // variant filter only benchmarks carrying that label, and only that
    // variant, are shown. Calls variants() without setup().
    public static #String listing(ArrayList<Benchmark> benchmarks, String areaFilter, String benchFilter,
                                  String variantFilter, boolean verbose) {
        StringBuilder sb = heap StringBuilder();
        int32 n = benchmarks.count();
        int32 k = 0;
        while (k < n) {
            Benchmark b = benchmarks.get(k);
            boolean keep = BenchMain.selected(b, areaFilter, benchFilter);
            if (keep && variantFilter != null) {
                keep = Harness.hasVariant(b, variantFilter);
            }
            if (keep) {
                if (!verbose) {
                    sb.append("  " + b.area() + "/" + b.name() + "  [" + b.backend() + "]\n");
                } else {
                    sb.append("  " + b.area() + "/" + b.name() + "\n");
                    ArrayList<String> vs #= b.variants();
                    int32 vi = 0;
                    int32 vn = vs.count();
                    while (vi < vn) {
                        String v = vs.get(vi);
                        if (variantFilter == null || v.equals(variantFilter)) {
                            String label = "" + v;
                            if (label.isEmpty()) {
                                label = "(no variant)";
                            }
                            String line #= "      " + label + " [" + b.backendFor(v) + "]";
                            if (!b.supportsVariant(v)) {
                                line #= line + " skipped: " + b.skipReasonFor(v);
                            }
                            sb.append(line);
                            sb.append("\n");
                        }
                        vi = vi + 1;
                    }
                }
            }
            k = k + 1;
        }
        return sb.toString();
    }
}
