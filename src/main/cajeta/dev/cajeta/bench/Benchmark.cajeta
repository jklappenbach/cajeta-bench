package dev.cajeta.bench;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.Machine;

// Base class for every benchmark in the ecosystem. Each benchmark extends
// Benchmark and overrides the lifecycle methods; a consumer's entry point
// builds an ArrayList<Benchmark>, pushes one instance of every benchmark
// into it, and hands the list to BenchMain.run, which lists or measures them
// — so adding a benchmark means writing a new .cajeta file and one
// `benchmarks.add(heap NewBenchmark());` line.
//
// As in the tour, Cajeta has no formal `abstract` keyword today, so these
// land as empty/identity concrete methods; subclasses override by signature.
// The lifecycle the Harness invokes, in order, per benchmark:
//
//   setup()        — allocate inputs, fetch/checksum datasets (later units)
//   run(iters)     — execute the measured workload `iters` times
//   teardown()     — release inputs
//   checkResult()  — structural correctness cross-check (true = pass)
//
// name()/area() identify the benchmark (used by `--list` and as CSV
// columns; area() is the catalog path, `collection/hashmap`); datasetInfo() describes the input (name/size/checksum) for the
// reproducibility record.
public class Benchmark {

    // Identity — overridden by every concrete benchmark.
    public String name() {
        return "benchmark";
    }

    public String area() {
        return "none";
    }

    // The XPU backend that executed this benchmark's measured run (cpu|hip|
    // vulkan|...). Recorded on the result row so GPU benches can be grouped by
    // backend in the report. CPU/host benchmarks keep the "cpu" default; a GPU
    // @Kernel benchmark overrides this to report the runtime-selected device.
    public String backend() {
        return "cpu";
    }

    // Describes the input dataset (name / size / checksum) for the report.
    // Empty when the benchmark is self-generating.
    public String datasetInfo() {
        return "";
    }

    // Methodology knobs the measurement loop (Harness, Unit 3) reads. Defaults
    // match the bench/ precedent; slow benchmarks override with fewer trials.
    public int32 warmupIters() {
        return 20;
    }

    public int32 measuredIters() {
        return 200;
    }

    // Nanoseconds of unavoidable per-iteration overhead (allocation / fresh-
    // buffer read) to subtract from each measured trial — the BindBench pattern.
    // 0 = nothing to subtract.
    public int64 baselineNanos() {
        return (int64) 0;
    }

    // Input size for the current variant, in the numerator unit of unit():
    // the harness writes throughput = inputSize / median seconds, labelled
    // unit() (so unit() "MB/s" wants inputSize in MB, "items/s" in items).
    // -1 = not applicable, and the throughput column stays empty.
    public int64 inputSize() {
        return (int64) -1;
    }

    // Whether this benchmark can run in the current environment. A dataset-backed
    // benchmark returns false when its corpus isn't configured/fetched, so the
    // harness records a skipped row instead of crashing on a missing file.
    public boolean available() {
        return true;
    }

    // Whether a specific variant can run. A benchmark with a per-input limitation
    // (e.g. the v1 JSON DOM not parsing floats, so only integer-only inputs work)
    // returns false for the unsupported variants; the harness records a skip row
    // (with skipReason) instead of letting the workload throw.
    public boolean supportsVariant(String variant) {
        return true;
    }

    public String skipReason() {
        return "variant not supported by this benchmark";
    }

    // Variant matrix (spec §4.4/§4.5). A benchmark with parameterized inputs —
    // sort {type×pattern×prediction}, JSON {in-order/out-of-order/missing-key} —
    // returns one label per variant; the measurement loop produces one result row
    // per label. Default: a single unlabelled variant. `prepare(variant)` builds
    // the per-variant input; `runVariant` is the measured body for that variant.
    public #ArrayList<String> variants() {
        ArrayList<String> v = heap ArrayList<String>();
        v.add("");
        return v;
    }

    public void prepare(String variant) {
    }

    public void runVariant(String variant, int32 iterations) {
        this.run(iterations);
    }

    // Lifecycle. setup → run → teardown → checkResult, driven by Harness.
    // A throw from setup, run or runVariant becomes a `failed` row carrying
    // the message; the run continues with the next variant or benchmark.
    public void setup() {
    }

    public void run(int32 iterations) {
    }

    public void teardown() {
    }

    // Structural correctness cross-check. true = the workload produced the
    // expected result this run; false marks the result invalid.
    public boolean checkResult() {
        return true;
    }

    // ---- schema v2 identity (spec §3.2) --------------------------------

    // The `machine` column: CAJETA_BENCH_MACHINE, else the hostname
    // lowercased. Override only for a row measured somewhere else.
    public String machine() {
        return Machine.resolve();
    }

    // The throughput unit (`MB/s`, `tokens/s`, `req/s`) written to
    // throughput_unit, so the site's chart labels itself. "" = time only.
    public String unit() {
        return "";
    }

    // Free text appended to the row's notes: competitor build flags, the
    // greedy-agreement rate, anything a reader needs to trust the number.
    public String competitorNote() {
        return "";
    }

    // The engine or library that produced the row (`cajeta-llm 0.9.0 hip`,
    // `dev.cajeta.http 0.9.1`). Language and stdlib rows keep the language.
    public String platform() {
        return "cajeta";
    }

    // The LLM or ML model identity with its quantization and checksum
    // (`Llama-3.1-8B Q4_K_M sha256:...`). "" outside ml and llm.
    public String model() {
        return "";
    }

    // ---- interleaved device rounds (spec §8.1, plan 14.1.3) -------------
    //
    // A row whose backend() is not "cpu" and that declares a competitor is
    // measured in interleaved rounds: ours, competitor, ours, competitor,
    // ..., so both sides see the same clocks and the same thermal state. Each
    // side's median goes on its own row. runCompetitor is the competitor's
    // measured body for one iteration (typically a launch of its prebuilt
    // reference binary or a call into its library).

    public boolean hasCompetitor() {
        return false;
    }

    // language column of the competitor row (`cuda-c++`, `hip-c++`, `python`).
    public String competitorLanguage() {
        return "";
    }

    // platform column of the competitor row (`BabelStream 5.0 cuda`, `llama.cpp b6123 hip`).
    public String competitorPlatform() {
        return "";
    }

    // language_version of the competitor row (toolchain or library version).
    public String competitorVersion() {
        return "";
    }

    public void runCompetitor(String variant, int32 iterations) {
    }

    // Correctness of the competitor's last run; false marks its row invalid.
    public boolean checkCompetitor() {
        return true;
    }

    // ---- external commands (0.1.1, ExternalBenchmark) -------------------

    // True when the measured work runs in a child process. The harness then
    // reports the child's peak RSS (measuredPeakRssKb) and no in-process
    // allocation count, and tags the row's notes `external`.
    public boolean external() {
        return false;
    }

    // The child's peak resident set in KiB, measured outside the timed
    // trials; -1 when it cannot be measured. Read only when external().
    public int64 measuredPeakRssKb() {
        return (int64) -1;
    }

    // ---- 0.1.2 -------------------------------------------------------------

    // The library the row measures, for the `library` / `library_version`
    // columns (`dev.cajeta.ml` / `0.10.6`, `dev.cajeta.llm` / `0.9.0`).
    // "" for language and stdlib rows.
    public String library() {
        return "";
    }

    public String libraryVersion() {
        return "";
    }

    // The backend one variant runs on. The harness reads this, not backend(),
    // for the row's backend and driver columns and for interleaving, so a
    // benchmark whose variants span devices (host / cuda / vulkan) says so
    // per variant. Default: backend() for every variant.
    public String backendFor(String variant) {
        return this.backend();
    }

    // Why `variant` is skipped when supportsVariant(variant) is false.
    // Default: skipReason().
    public String skipReasonFor(String variant) {
        return this.skipReason();
    }
}
