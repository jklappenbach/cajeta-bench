package dev.cajeta.bench.report;

import cajeta.collection.ArrayList;
import cajeta.lang.StringBuilder;
import cajeta.io.file.File;
import cajeta.io.file.FileWriter;
import cajeta.io.file.OpenMode;
import dev.cajeta.bench.report.Result;

// RFC 4180 CSV field escaping for the report writer. A field is
// quoted only when it contains a comma, double-quote, CR or LF; inside a quoted
// field, embedded double-quotes are doubled. Numbers and simple tokens pass
// through unquoted so the CSV stays human- and pandas-friendly.
public class Csv {

    // ASCII bytes we must guard against: ',' 44, '"' 34, '\n' 10, '\r' 13.
    // Scanned by BYTE (byteLength/byteAt/substring are byte-indexed;
    // String.count() is codepoints, which in 0.1.0-0.1.2 left the tail of
    // any field holding a multi-byte character unscanned and uncopied).
    public static #String field(String s) {
        if (s == null) {
            return "";
        }
        int32 n = s.byteLength();
        boolean needsQuote = false;
        int32 i = 0;
        while (i < n) {
            int8 c = s.byteAt(i);
            if (c == 44 || c == 34 || c == 10 || c == 13) {
                needsQuote = true;
            }
            i = i + 1;
        }
        if (!needsQuote) {
            // Return a fresh owned copy (the #String contract) — never the
            // borrowed parameter.
            return "" + s;
        }
        String out = "\"";
        int32 j = 0;
        while (j < n) {
            int8 c = s.byteAt(j);
            if (c == 34) {
                out = out + "\"\"";
            } else {
                out = out + s.substring(j, j + 1);
            }
            j = j + 1;
        }
        out = out + "\"";
        return out;
    }

    // Canonical boolean rendering for CSV cells.
    public static #String boolStr(boolean b) {
        if (b) {
            return "true";
        }
        return "false";
    }

    // The whole results CSV: the schema header, then one line per row, each
    // line ending in "\n".
    public static #String render(ArrayList<Result> rows) {
        StringBuilder sb = heap StringBuilder();
        sb.append(Result.header());
        sb.append("\n");
        int32 i = 0;
        int32 n = rows.count();
        while (i < n) {
            Result r = rows.get(i);
            sb.append(r.toRow());
            sb.append("\n");
            i = i + 1;
        }
        return sb.toString();
    }

    // Write render(rows) to `path`, replacing any file there. false when the
    // file could not be opened (a missing directory, no permission): the
    // writer's fd is then -1 and writes would vanish without an error.
    public static boolean write(String path, ArrayList<Result> rows) {
        String text #= Csv.render(rows);
        FileWriter w #= File.openWrite(path, OpenMode.WRITE);
        if (w.fd < 0) {
            return false;
        }
        w.writeString(text);
        w.flush();
        w.close();
        return true;
    }
}
