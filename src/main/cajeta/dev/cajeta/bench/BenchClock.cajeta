package dev.cajeta.bench;

import cajeta.time.Clock;

/**
 * The clock the harness times trials with. The real one is the monotonic
 * `Clock.nanoTime`; a test substitutes a subclass through
 * `BenchConfig.useClock` to pin every duration (plan 14.1.3).
 */
public class BenchClock {
    public BenchClock() {
        return;
    }

    public int64 nanoTime() {
        return Clock.nanoTime();
    }

    // Wall-clock seconds since the Unix epoch, for timestamp_unix.
    public int64 unixSeconds() {
        return Clock.millisTime() / 1000;
    }
}
