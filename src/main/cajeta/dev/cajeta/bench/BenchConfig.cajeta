package dev.cajeta.bench;

import cajeta.collection.ArrayList;

import dev.cajeta.bench.BenchClock;
import dev.cajeta.bench.detect.OsDetect;
import dev.cajeta.bench.detect.DriverDetect;
import dev.cajeta.bench.detect.Sys;

/**
 * Everything about one run that is not a benchmark: the run id, smoke mode,
 * the toolchain identity written into every row, the detected OS, the
 * per-family driver strings (detected once, on first use), and the clock.
 *
 * `fromEnv()` is what `BenchMain` uses. The environment it reads:
 *
 *   CAJETA_BENCH_SMOKE           1/true: warmup 1, trials 3, rows tagged `smoke`
 *   CAJETA_BENCH_RUN_ID          the run id (PROFILE_RUN_ID still honored)
 *   CAJETA_BENCH_CAJETA_VERSION  language_version of cajeta rows
 *                                (PROFILE_CAJETA_VERSION still honored);
 *                                unset: `cajeta --version` on PATH
 *   CAJETA_BENCH_FLAGS           the flags column of cajeta rows
 *   CAJETA_BENCH_MACHINE         read per row by Benchmark.machine()
 *   CAJETA_BENCH_NO_GPU          1/true: no driver probe; `driver: not probed`
 */
public class BenchConfig {
    public boolean smoke;
    public String runId;
    public String languageVersion;
    public String flags;
    public String os;
    public BenchClock clock;
    // Measure only this variant label ("" = every variant). BenchMain --variant.
    public String variantFilter;
    // CAJETA_BENCH_NO_GPU=1: no driver probe runs, `driver` stays empty, and
    // non-cpu rows' notes say `driver: not probed`.
    public boolean noGpu;
    // How many driver probes (nvidia-smi, hipconfig, vulkaninfo) have run.
    public int32 probes;
    // env.csv extras collected from Benchmark.envExtra.
    public ArrayList<String> envKeys;
    public ArrayList<String> envValues;

    public String nvidiaDriver;
    public String rocmDriver;
    public String vulkanDriver;
    public boolean nvidiaKnown;
    public boolean rocmKnown;
    public boolean vulkanKnown;

    public BenchConfig() {
        this.smoke = false;
        this.runId = "local-run";
        this.languageVersion = "";
        // What the `release` flavor the consumer's bench task builds with is
        // expected to be; CAJETA_BENCH_FLAGS overrides it with the truth.
        this.flags = "--release -O3 -march=native";
        this.os = "";
        this.clock = heap BenchClock();
        this.variantFilter = "";
        this.noGpu = false;
        this.probes = 0;
        this.envKeys = heap ArrayList<String>();
        this.envValues = heap ArrayList<String>();
        this.nvidiaDriver = "";
        this.rocmDriver = "";
        this.vulkanDriver = "";
        this.nvidiaKnown = false;
        this.rocmKnown = false;
        this.vulkanKnown = false;
    }

    public static #BenchConfig fromEnv() {
        BenchConfig c = heap BenchConfig();
        c.smoke = BenchConfig.parseSmoke(System.env.get("CAJETA_BENCH_SMOKE"));
        c.noGpu = BenchConfig.parseSmoke(System.env.get("CAJETA_BENCH_NO_GPU"));
        String rid #= BenchConfig.envOr("CAJETA_BENCH_RUN_ID", "PROFILE_RUN_ID");
        if (rid != null) {
            c.runId = "" + rid;
        }
        String ver #= BenchConfig.envOr("CAJETA_BENCH_CAJETA_VERSION", "PROFILE_CAJETA_VERSION");
        if (ver != null) {
            c.languageVersion = "" + ver;
        } else {
            c.languageVersion #= BenchConfig.detectCajetaVersion();
        }
        String fl = System.env.get("CAJETA_BENCH_FLAGS");
        if (fl != null) {
            c.flags = "" + fl;
        }
        c.os #= OsDetect.detect();
        return c;
    }

    /** A copy of the first of two environment variables that is set, else null. */
    public static #String envOr(String primary, String legacy) {
        String a = System.env.get(primary);
        if (a != null) {
            return "" + a;
        }
        String b = System.env.get(legacy);
        if (b != null) {
            return "" + b;
        }
        return null;
    }

    public static boolean parseSmoke(String v) {
        if (v == null) {
            return false;
        }
        return v.equals("1") || v.equals("true") || v.equals("yes");
    }

    /** Replace the clock (tests: a scripted FakeClock). */
    public void useClock(#BenchClock c) {
        this.clock #= c;
    }

    /** Pin the driver string for `backend`'s family instead of detecting it. */
    public void setDriver(String backend, String driver) {
        String fam #= DriverDetect.family(backend);
        if (fam.equals("nvidia")) {
            this.nvidiaDriver = "" + driver;
            this.nvidiaKnown = true;
        } else if (fam.equals("rocm")) {
            this.rocmDriver = "" + driver;
            this.rocmKnown = true;
        } else if (fam.equals("vulkan")) {
            this.vulkanDriver = "" + driver;
            this.vulkanKnown = true;
        }
    }

    /**
     * The driver column for a MEASURED row on `backend`: "" on cpu and under
     * noGpu (no probe runs), else detected once per family.
     */
    public #String driverFor(String backend) {
        if (this.noGpu) {
            return "";
        }
        String fam #= DriverDetect.family(backend);
        if (fam.equals("nvidia")) {
            if (!this.nvidiaKnown) {
                this.probes = this.probes + 1;
                this.nvidiaDriver #= DriverDetect.forBackend(backend);
                this.nvidiaKnown = true;
            }
            return "" + this.nvidiaDriver;
        }
        if (fam.equals("rocm")) {
            if (!this.rocmKnown) {
                this.probes = this.probes + 1;
                this.rocmDriver #= DriverDetect.forBackend(backend);
                this.rocmKnown = true;
            }
            return "" + this.rocmDriver;
        }
        if (fam.equals("vulkan")) {
            if (!this.vulkanKnown) {
                this.probes = this.probes + 1;
                this.vulkanDriver #= DriverDetect.forBackend(backend);
                this.vulkanKnown = true;
            }
            return "" + this.vulkanDriver;
        }
        return "";
    }

    /** The driver for a skipped or failed row: what is already known, never a probe. */
    public #String knownDriver(String backend) {
        if (this.noGpu) {
            return "";
        }
        String fam #= DriverDetect.family(backend);
        if (fam.equals("nvidia") && this.nvidiaKnown) {
            return "" + this.nvidiaDriver;
        }
        if (fam.equals("rocm") && this.rocmKnown) {
            return "" + this.rocmDriver;
        }
        if (fam.equals("vulkan") && this.vulkanKnown) {
            return "" + this.vulkanDriver;
        }
        return "";
    }

    /** Add or replace an env.csv extra (the last value for a key wins). */
    public void addEnv(String key, String value) {
        int32 i = 0;
        while (i < this.envKeys.count()) {
            String k = this.envKeys.get(i);
            if (k.equals(key)) {
                String v = "" + value;
                this.envValues.set(i, #v);
                return;
            }
            i = i + 1;
        }
        String nk = "" + key;
        String nv = "" + value;
        this.envKeys.add(#nk);
        this.envValues.add(#nv);
    }

    // The compiler version for language_version when CAJETA_BENCH_CAJETA_VERSION
    // is unset: the runtime has no version API (cajeta 0.46.3), so this asks
    // `cajeta --version` of the compiler on PATH. That is the compiler a
    // `cajeta bench` task ran under, which is the one that built the binary;
    // a binary run by hand with another cajeta first on PATH records that
    // one, and with none on PATH the column stays "".
    public static #String detectCajetaVersion() {
        String out #= Sys.run1("cajeta", "--version");
        return BenchConfig.parseCajetaVersion(out);
    }

    // `cajeta 0.46.3 (b5689bda)` → `0.46.3`; "" for anything else.
    public static #String parseCajetaVersion(String text) {
        if (text == null) {
            return "";
        }
        if (!text.startsWith("cajeta ")) {
            return "";
        }
        return Sys.tokenAfter(text, "cajeta ");
    }
}
