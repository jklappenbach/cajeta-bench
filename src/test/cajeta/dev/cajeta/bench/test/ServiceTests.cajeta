package dev.cajeta.bench.test;

import cajeta.collection.ArrayList;
import dev.cajeta.unit.Assert;
import dev.cajeta.bench.BenchConfig;
import dev.cajeta.bench.Harness;
import dev.cajeta.bench.ServiceBenchmark;
import dev.cajeta.bench.report.Result;

/**
 * 0.1.4: ServiceBenchmark starts a long-running service, waits for it, runs a
 * measured phase, samples the service's VmHWM, and stops it by its recorded
 * PID. The service is src/test/python/tiny_server.py (BENCH_TEST_SERVER).
 */
public class ServiceTests {

    public ServiceTests() {
        return;
    }

    static #String[] serverArgv(int32 port, String mode) {
        String script = System.env.get("BENCH_TEST_SERVER");
        String[] v = heap String[4];
        v[0] = "python3";
        v[1] = "" + script;
        v[2] = "" + port;
        v[3] = "" + mode;
        return v;
    }

    static #String[] fetchBig(int32 port) {
        String[] v = heap String[4];
        v[0] = "python3";
        v[1] = "-c";
        v[2] = "import urllib.request, sys; print(urllib.request.urlopen('http://127.0.0.1:' + sys.argv[1] + '/big').status)";
        v[3] = "" + port;
        return v;
    }

    static #ServiceBenchmark tiny(int32 port, String mode) {
        ServiceBenchmark s = heap ServiceBenchmark();
        s.describe("tiny", "test/service");
        String[] argv #= ServiceTests.serverArgv(port, mode);
        s.service(#argv);
        s.readyOnUrl(port, "/health", 200);
        s.readyTimeoutMillis((int64) 15000);
        s.stopTimeoutMillis((int64) 3000);
        s.samplingMillis(20);
        s.iterations(0, 2);
        return s;
    }

    static boolean gone(int32 pid) {
        return !TestFiles.exists("/proc/" + pid);
    }

    @Test
    public void aServiceIsStartedWaitedForMeasuredSampledAndStopped() {
        BenchConfig cfg = heap BenchConfig();
        ServiceBenchmark s #= ServiceTests.tiny(18741, "");
        String[] phase #= ServiceTests.fetchBig(18741);
        s.command(#phase);
        Result r #= ExternalTests.measureAlone(s, cfg);
        Assert.that(r.status).isEqualTo("ok");
        Assert.that(r.notes).contains("external");
        Assert.that(s.stdout()).isEqualTo("200\n");
        // Two phases each made the service hold 64 MiB more: its VmHWM, not ours.
        Assert.that(r.peakRssKb).isGreaterThanOrEqualTo(131072);
        Assert.that(r.medianNs).isGreaterThan(0);
        Assert.that((int64) s.lastServicePid).isGreaterThan(0);
        Assert.isTrue(ServiceTests.gone(s.lastServicePid));
        // No extra run for the peak: the phase ran exactly warmup + trials times.
        Assert.that((int64) s.phaseRuns).isEqualTo(2);
        return;
    }

    @Test
    public void tcpReadinessAndAnInProcessPhaseThatReportsItsOwnTime() {
        BenchConfig cfg = heap BenchConfig();
        TcpPhaseService s = heap TcpPhaseService();
        s.describe("tcp", "test/service");
        String[] argv #= ServiceTests.serverArgv(18742, "");
        s.service(#argv);
        s.readyOnPort(18742);
        s.readyTimeoutMillis((int64) 15000);
        s.iterations(1, 3);
        Result r #= ExternalTests.measureAlone(s, cfg);
        Assert.that(r.status).isEqualTo("ok");
        Assert.that(r.medianNs).isEqualTo(4242);
        Assert.that(r.notes).contains("reported");
        Assert.that((int64) s.phases).isEqualTo(4);
        Assert.isTrue(ServiceTests.gone(s.lastServicePid));
        return;
    }

    @Test
    public void aServiceThatNeverAnswersIsAFailedRowAndIsStopped() {
        BenchConfig cfg = heap BenchConfig();
        ServiceBenchmark s #= ServiceTests.tiny(18743, "slow");
        s.readyTimeoutMillis((int64) 1500);
        Result r #= ExternalTests.measureAlone(s, cfg);
        Assert.that(r.status).isEqualTo("failed");
        Assert.that(r.notes).contains("not ready");
        Assert.isTrue(ServiceTests.gone(s.lastServicePid));
        return;
    }

    @Test
    public void aServiceThatExitsBeforeReadyIsAFailedRow() {
        BenchConfig cfg = heap BenchConfig();
        ServiceBenchmark s #= ServiceTests.tiny(18744, "exit");
        Result r #= ExternalTests.measureAlone(s, cfg);
        Assert.that(r.status).isEqualTo("failed");
        Assert.that(r.notes).contains("exited 3 before it was ready");
        return;
    }

    @Test
    public void aServiceIgnoringTermIsKilledAfterTheStopTimeout() {
        BenchConfig cfg = heap BenchConfig();
        ServiceBenchmark s #= ServiceTests.tiny(18745, "ignore-term");
        s.stopTimeoutMillis((int64) 500);
        String[] phase #= ServiceTests.fetchBig(18745);
        s.command(#phase);
        s.iterations(0, 1);
        Result r #= ExternalTests.measureAlone(s, cfg);
        Assert.that(r.status).isEqualTo("ok");
        Assert.isTrue(ServiceTests.gone(s.lastServicePid));
        Assert.that(s.lastStopSignal).isEqualTo("KILL");
        return;
    }

    @Test
    public void relaunchEachTrialReportsTheTimeToReady() {
        BenchConfig cfg = heap BenchConfig();
        ServiceBenchmark s #= ServiceTests.tiny(18746, "");
        s.relaunchEachTrial(true);
        Result r #= ExternalTests.measureAlone(s, cfg);
        Assert.that(r.status).isEqualTo("ok");
        Assert.that(r.notes).contains("reported");
        Assert.that(r.medianNs).isGreaterThan(0);
        Assert.that(r.medianNs).isLessThan(15000000000);
        Assert.that(s.lastStopSignal).isEqualTo("TERM");
        Assert.isTrue(ServiceTests.gone(s.lastServicePid));
        return;
    }
}
