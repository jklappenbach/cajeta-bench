package dev.cajeta.bench.test;

import cajeta.collection.ArrayList;
import dev.cajeta.unit.Assert;
import dev.cajeta.bench.Benchmark;
import dev.cajeta.bench.BenchMain;

/** Plan 1.2.2: the --list / --run / --area / --bench / --out command line. */
public class BenchMainTests {

    public BenchMainTests() {
        return;
    }

    static #ArrayList<Benchmark> suite() {
        ArrayList<Benchmark> list = heap ArrayList<Benchmark>();
        list.add(heap CountingBench());
        list.add(heap VariantsBench(true));
        list.add(heap ThrowingBench());
        return list;
    }

    static #String[] argv3(String a, String b, String c) {
        String[] v = heap String[3];
        v[0] = "" + a;
        v[1] = "" + b;
        v[2] = "" + c;
        return v;
    }

    @Test
    public void listExitsZeroWithoutMeasuring() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String[] args = heap String[1];
        args[0] = "--list";
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(0);
        CountingBench c = (CountingBench) list.get(0);
        Assert.that((int64) c.runs).isEqualTo(0);
        return;
    }

    @Test
    public void runWritesEveryRowAndExitsNonZeroWhenARowFailed() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String out #= TestFiles.scratch("main-all.csv");
        String[] args #= BenchMainTests.argv3("--run", "--out", out);
        // counting (1) + variants (3, one skipped) + throwing (1 failed)
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(1);
        String text #= TestFiles.read(out);
        Assert.that((int64) TestFiles.lineCount(text)).isEqualTo(6);
        Assert.that(text).contains(",failed,");
        return;
    }

    @Test
    public void areaAndBenchSelectRows() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String out #= TestFiles.scratch("main-area.csv");
        String[] args = heap String[5];
        args[0] = "--run";
        args[1] = "--area";
        args[2] = "test/variants";
        args[3] = "--out";
        args[4] = "" + out;
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(0);
        String text #= TestFiles.read(out);
        Assert.that((int64) TestFiles.lineCount(text)).isEqualTo(4);

        String out2 #= TestFiles.scratch("main-bench.csv");
        String[] args2 = heap String[5];
        args2[0] = "--run";
        args2[1] = "--bench";
        args2[2] = "counting";
        args2[3] = "--out";
        args2[4] = "" + out2;
        Assert.that((int64) BenchMain.run(args2, list)).isEqualTo(0);
        String text2 #= TestFiles.read(out2);
        Assert.that((int64) TestFiles.lineCount(text2)).isEqualTo(2);
        Assert.that(text2).contains(",counting,test/counting,");
        return;
    }

    @Test
    public void runAlsoWritesEnvCsvBesideResults() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String out #= TestFiles.scratch("results.csv");
        String[] args = heap String[5];
        args[0] = "--run";
        args[1] = "--bench";
        args[2] = "counting";
        args[3] = "--out";
        args[4] = "" + out;
        BenchMain.run(args, list);
        String envPath #= TestFiles.scratch("env.csv");
        String env #= TestFiles.read(envPath);
        Assert.that(env).startsWith("key,value\n");
        Assert.that(env).contains("machine,bench-test-machine\n");
        Assert.that(env).contains("schema_version,2\n");
        return;
    }

    @Test
    public void anUnknownFlagIsAUsageError() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String[] args = heap String[1];
        args[0] = "--frobnicate";
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(2);
        return;
    }

    // ---- 0.1.1: --out into a directory that does not exist ---------------

    @Test
    public void outIntoAMissingDirectoryCreatesIt() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String out #= TestFiles.scratch("made/on/demand/results.csv");
        String[] args = heap String[5];
        args[0] = "--run";
        args[1] = "--bench";
        args[2] = "counting";
        args[3] = "--out";
        args[4] = "" + out;
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(0);
        String text #= TestFiles.read(out);
        Assert.that((int64) TestFiles.lineCount(text)).isEqualTo(2);
        String envPath #= TestFiles.scratch("made/on/demand/env.csv");
        String env #= TestFiles.read(envPath);
        Assert.that(env).startsWith("key,value\n");
        return;
    }

    @Test
    public void outUnderARegularFileIsAUsageErrorAndWritesNothing() {
        String blocker #= TestFiles.scratch("blocker");
        TestFiles.write(blocker, "not a directory\n");
        String out #= TestFiles.scratch("blocker/results.csv");
        String why #= BenchMain.prepareOut(out);
        Assert.that(why).contains(out);
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String[] args = heap String[5];
        args[0] = "--run";
        args[1] = "--bench";
        args[2] = "counting";
        args[3] = "--out";
        args[4] = "" + out;
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(2);
        // Nothing measured: the check comes before the run.
        CountingBench c = (CountingBench) list.get(0);
        Assert.that((int64) c.runs).isEqualTo(0);
        String still #= TestFiles.read(blocker);
        Assert.that(still).isEqualTo("not a directory\n");
        return;
    }

    @Test
    public void anExistingOrBareOutNeedsNoPreparation() {
        String here #= BenchMain.prepareOut("results.csv");
        Assert.that(here).isEqualTo("");
        String dir #= TestFiles.scratch("results.csv");
        String there #= BenchMain.prepareOut(dir);
        Assert.that(there).isEqualTo("");
        return;
    }

    // ---- 0.1.2: --variant and --list --verbose -----------------------------

    @Test
    public void variantSelectsOneVariantOfTheSelectedBenchmarks() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String out #= TestFiles.scratch("main-variant.csv");
        String[] args = heap String[7];
        args[0] = "--run";
        args[1] = "--bench";
        args[2] = "variants";
        args[3] = "--variant";
        args[4] = "medium";
        args[5] = "--out";
        args[6] = "" + out;
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(0);
        String text #= TestFiles.read(out);
        Assert.that((int64) TestFiles.lineCount(text)).isEqualTo(2);
        Assert.that(text).contains(",medium,");
        return;
    }

    @Test
    public void aVariantNoBenchmarkHasMatchesNothing() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String out #= TestFiles.scratch("main-novariant.csv");
        String[] args = heap String[5];
        args[0] = "--run";
        args[1] = "--variant";
        args[2] = "enormous";
        args[3] = "--out";
        args[4] = "" + out;
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(1);
        String text #= TestFiles.read(out);
        Assert.that((int64) TestFiles.lineCount(text)).isEqualTo(1);
        return;
    }

    @Test
    public void verboseListingShowsVariantsAndBackends() {
        ArrayList<Benchmark> list = heap ArrayList<Benchmark>();
        list.add(heap VariantsBench(true));
        list.add(heap MixedBackendBench());
        String plain #= BenchMain.listing(list, null, null, null, false);
        Assert.that(plain).contains("test/variants/variants");
        Assert.that(plain).contains("xpu/mixed/mixed");
        Assert.isFalse(plain.contains("medium"));
        String full #= BenchMain.listing(list, null, null, null, true);
        Assert.that(full).contains("medium [cpu]");
        Assert.that(full).contains("large [cpu] skipped: large needs the 1 GB corpus");
        Assert.that(full).contains("cuda [cuda]");
        Assert.that(full).contains("vulkan [vulkan] skipped: no vulkan device on this machine");
        String one #= BenchMain.listing(list, null, null, "cuda", true);
        Assert.isFalse(one.contains("test/variants/variants"));
        Assert.isFalse(one.contains("host [cpu]"));
        Assert.that(one).contains("cuda [cuda]");
        return;
    }

    @Test
    public void verboseIsAcceptedWithList() {
        ArrayList<Benchmark> list #= BenchMainTests.suite();
        String[] args = heap String[2];
        args[0] = "--list";
        args[1] = "--verbose";
        Assert.that((int64) BenchMain.run(args, list)).isEqualTo(0);
        return;
    }
}
