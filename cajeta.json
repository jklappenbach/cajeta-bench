{
    // cajeta-bench — the benchmark harness every repo in the Cajeta ecosystem
    // measures with: one `Benchmark` contract, one CSV schema (v2), and one
    // `--list` / `--run` / `--area` / `--bench` / `--out` command line.
    // Spec: cajeta/specs/benchmark-reference-spec.md §3.
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable `.cja`.
    // A consumer declares `"dev.cajeta.bench": "0.1.0"` in its dependencies and
    // writes a three-line entry point that hands its benchmarks to
    // `dev.cajeta.bench.BenchMain.run`.
    //
    // VERSIONING — `details.version` is the single source of truth. It names
    // the built archive (`dev.cajeta.bench-<version>.cja`) and is what CI
    // publishes to Olla. There is deliberately no VERSION file.

    "details": {
        "name":               "dev.cajeta.bench",
        "version":            "0.1.4",
        "description":        "cajeta-bench — benchmark harness: Benchmark contract, schema-v2 CSV rows, and the bench CLI",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // The harness times workloads (clock), writes the results CSV and reads
        // /proc and /etc/os-release (filesystem), reads CAJETA_BENCH_* and the
        // hostname from the environment (env), and runs nvidia-smi, hipconfig,
        // vulkaninfo and `cmd /c ver` to record the driver and OS (process),
        // and ServiceBenchmark probes a service's readiness over TCP (network).
        // Capabilities are re-validated against the consumer's manifest, so a
        // consumer's bench project declares the same five.
        "capabilities": ["filesystem", "clock", "env", "process", "network"],

        "dependencies": {},

        // The suite runs on cajeta-unit's reflective @Test discovery.
        // `cajeta build` does not resolve dev-dependencies today, so
        // run-tests.sh resolves the archive itself (checkout, store, Olla).
        "dev-dependencies": {
            "dev.cajeta.unit": "0.3.6"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        // NO `entry-method` here — that is what makes this a library.
        "build": {
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's unit tests",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "release": {
            "description": "Optimized release build of the library (.cja)",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Wipe build outputs",
            "actions": [ { "action": "clean" } ]
        }
    }
}
